# Postgres (Render Postgres in production)
DATABASE_URL=postgresql://user:password@localhost:5432/openaisle

# PayPal REST (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# LLMs
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Public base URL (used for PayPal return/cancel URLs and MCP links)
APP_URL=http://localhost:3000

# Optional: override the Gemini fallback model (default: gemini-flash-latest)
GEMINI_MODEL=
