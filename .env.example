# Postgres (Render Postgres). Use the database's External URL locally and on Render.
DATABASE_URL=postgresql://user:password@localhost:5432/openaisle

# PayPal REST (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID from your PayPal app (Sandbox webhooks -> your https://.../api/paypal/webhook URL)
PAYPAL_WEBHOOK_ID=

# LLMs
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Public base URL, no trailing slash. Used for PayPal return/cancel URLs, MCP URLs and llms.txt.
# Local: http://localhost:3000   Render: https://<your-service>.onrender.com
APP_URL=http://localhost:3000

# Optional: override the Gemini fallback model (default: gemini-flash-latest)
GEMINI_MODEL=

# Optional: enable the Copilot list_transactions tool (requires "Transaction search" on your PayPal app)
PAYPAL_TRANSACTION_SEARCH=false
