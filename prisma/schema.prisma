generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  APPROVED
  COMPLETED
  REFUNDED
  CANCELLED
}

enum Channel {
  WEB_AGENT
  MCP
}

enum AgentEventType {
  SEARCH
  VIEW
  CHECKOUT_CREATED
  PAYMENT_CAPTURED
  REFUNDED
  POLICY_BLOCKED
  COPILOT_ACTION
}

model Store {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  tagline             String?
  description         String?
  currency            String       @default("USD")
  returnPolicy        String?
  shippingPolicy      String?
  maxOrderValue       Decimal      @default(500) @db.Decimal(10, 2)
  agentReadinessScore Int?
  readinessReport     Json?
  createdAt           DateTime     @default(now())
  products            Product[]
  orders              Order[]
  events              AgentEvent[]
}

model Product {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku             String
  title           String
  description     String?
  agentSummary    String?
  price           Decimal  @db.Decimal(10, 2)
  stock           Int      @default(0)
  imageUrl        String?
  attributes      Json     @default("{}")
  tags            String[]
  paypalProductId String?
  createdAt       DateTime @default(now())

  @@unique([storeId, sku])
}

model Order {
  id             String      @id @default(cuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ref            String      @unique
  paypalOrderId  String      @unique
  status         OrderStatus @default(CREATED)
  items          Json
  total          Decimal     @db.Decimal(10, 2)
  currency       String      @default("USD")
  captureId      String?
  buyerEmail     String?
  channel        Channel
  agentClient    String?
  trackingNumber String?
  carrier        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([storeId, createdAt])
}

model AgentEvent {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type        AgentEventType
  channel     Channel?
  query       String?
  resultCount Int?
  payload     Json           @default("{}")
  createdAt   DateTime       @default(now())

  @@index([storeId, createdAt])
}
